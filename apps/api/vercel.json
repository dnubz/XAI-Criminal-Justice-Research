{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix ../..",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/published,dist}/**"
    }
  },
  "routes": [
    { "src": "/api/v1/.*", "dest": "/api" }
  ]
}
