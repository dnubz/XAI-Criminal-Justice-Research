{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix ../..",
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/published,dist}/**"
    }
  },
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "/api" }
  ]
}
